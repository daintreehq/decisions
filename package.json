{
  "name": "daintree-decisions",
  "version": "0.3.0",
  "private": true,
  "description": "Daintree Decisions: a non-blocking, end-to-end encrypted human-in-the-loop relay for AI coding agents. Self-hosted on Cloudflare.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @daintreehq/decisions-app build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:tools",
    "test:tools": "node --test tools/release/release.test.mjs",
    "format": "prettier --write .",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "decisions": "node packages/cli/dist/bin.js",
    "decisions:deploy": "pnpm build:all && node packages/cli/dist/bin.js deploy",
    "decisions:doctor": "node tools/doctor/doctor.mjs",
    "deploy:local": "pnpm build && wrangler deploy",
    "build:all": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "pack:check": "node tools/pack-check/pack-check.mjs",
    "release:version": "node tools/release/version.mjs",
    "release:publish": "node tools/release/publish.mjs"
  },
  "cloudflare": {
    "bindings": {
      "CLAIM_SECRET": {
        "description": "Required. A one-time setup secret that lets only you claim this deployment for your Daintree installation. Generate one with `openssl rand -hex 32` and keep it: Daintree asks for it once during setup. Optional dictation keys (XAI_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY) can be added later under Settings > Variables and Secrets."
      }
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "prettier": "^3.3.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.156.0"
  }
}
