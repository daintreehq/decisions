{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daintree-decisions",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // Bundle the shared libraries from TypeScript source, as the rest of the workspace does through the
  // "@daintreehq/source" export condition (Wrangler cannot be given a condition in config). Without
  // this the Worker would need a prior library build, which the Deploy button never runs.
  "alias": {
    "@daintreehq/decisions-protocol": "./packages/protocol/src/index.ts",
    "@daintreehq/decisions-crypto": "./packages/crypto/src/index.ts",
  },
  "observability": { "enabled": false },
  "assets": {
    "directory": "./app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "daintree-decisions" }],
  "durable_objects": {
    "bindings": [{ "name": "DECISION_ROOM", "class_name": "DecisionRoom" }],
  },
  "exports": {
    "DecisionRoom": { "type": "durable-object", "storage": "sqlite" },
  },
  "vars": {
    "CORRECTION_MODEL": "claude-haiku-5-5",
    "OPENAI_CORRECTION_MODEL": "gpt-5-mini",
    "PUSH_SUBJECT": "",
  },
}
