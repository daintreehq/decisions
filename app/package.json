{
  "name": "@daintreehq/decisions-app",
  "version": "0.6.0",
  "private": true,
  "description": "Daintree Decisions phone app: installable PWA served by the user's own relay.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/make-icons.mjs --if-missing && vite build",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "theme": "node scripts/sync-theme.mjs"
  },
  "dependencies": {
    "@daintreehq/decisions-crypto": "workspace:*",
    "@daintreehq/decisions-protocol": "workspace:*",
    "idb": "^8.0.3",
    "jsqr": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.0"
  }
}
