{
  "name": "@daintree/decisions-client",
  "version": "0.1.0",
  "description": "Desktop-side reference implementation for Daintree Decisions: relay client, hibernatable socket, durable local store, delivery bridge and HTTP MCP server.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@daintree/decisions-crypto": "workspace:*",
    "@daintree/decisions-protocol": "workspace:*",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.0"
  }
}
