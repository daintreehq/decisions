{
  "name": "@daintreehq/decisions-crypto",
  "version": "0.1.0",
  "description": "WebCrypto implementation of the Daintree Decisions crypto suite (P-256 ECDSA/ECDH, HKDF, AES-256-GCM). Runs in browsers, Node and Cloudflare Workers.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "vectors": "node --experimental-strip-types tests/generate-vectors.ts"
  },
  "dependencies": {
    "@daintreehq/decisions-protocol": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.0",
    "typescript": "~5.9.0",
    "@types/node": "^22.0.0"
  }
}
