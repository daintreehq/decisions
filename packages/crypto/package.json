{
  "name": "@daintreehq/decisions-crypto",
  "version": "0.4.0",
  "description": "WebCrypto implementation of the Daintree Decisions crypto suite (P-256 ECDSA/ECDH, HKDF, AES-256-GCM). Runs in browsers, Node and Cloudflare Workers.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@daintreehq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/vectors.json": "./fixtures/vectors.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "fixtures/vectors.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "vectors": "node --experimental-strip-types tests/generate-vectors.ts"
  },
  "dependencies": {
    "@daintreehq/decisions-protocol": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.0",
    "typescript": "~5.9.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daintreehq/decisions.git",
    "directory": "packages/crypto"
  }
}
