{
  "name": "@daintreehq/decisions-model",
  "version": "0.2.0",
  "description": "Optional local decision model for Daintree Decisions: retrieval over the human's own past decisions plus a strictly-validated, policy-gated proxy engine.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@daintreehq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "@daintreehq/source": "./src/history-sqlite.ts",
      "types": "./dist/history-sqlite.d.ts",
      "default": "./dist/history-sqlite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@daintreehq/decisions-protocol": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daintreehq/decisions.git",
    "directory": "packages/decision-model"
  }
}
